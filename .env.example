# Copie para .env.local (dev) e configure no painel da Vercel (produção/preview).
# NUNCA commite arquivos .env com valores reais.

# Público: pode ir para o navegador (protegido pelo RLS do banco)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-ou-publishable-key

# Públicas: URL do site, usada nos links de email
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SECRETA: só no servidor. Sem prefixo NEXT_PUBLIC_. Usada apenas para excluir conta.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key
